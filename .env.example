# Copy to .env (never committed). Everything is optional: the app runs without any key.
# Without a key: search, graph, ontology training and evaluation work fully; the 5 starter questions show
# answers cached at build time and other questions get extractive, cited answers (see hybridrag/answer.py).

# Live generated answers in the app (and LLM steps in build.py) via OpenAI:
OPENAI_API_KEY=

# ...or via any OpenAI-compatible endpoint (Bedrock Mantle, Groq, OpenRouter, ...):
# LLM_BASE_URL=
# LLM_API_KEY=
# ANSWER_MODEL=moonshotai.kimi-k2.5
